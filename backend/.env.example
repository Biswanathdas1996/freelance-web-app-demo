# Optional: embedded Mongo via mongodb-memory-server (no Atlas / local daemon). Used when starting the API with USE_MEMORY_MONGO=1 (e.g. Playwright webServer unless PLAYWRIGHT_USE_ATLAS=1).
USE_MEMORY_MONGO=0

MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/dbname?appName=Cluster0
PORT=9001
FRONTEND_URL=http://localhost:9000
JWT_SECRET=change-me-in-production-use-long-random-string
